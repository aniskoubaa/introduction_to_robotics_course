<?xml version="1.0"?>
<!--
  EE 414 Week 4 - the two kinematic constants, written down as a robot.

  Slide reference: "The Model Needs Two Numbers. Where Do They Live?" and
  "A Differential Drive, in Twelve Lines of URDF".

  This is the smallest file that puts r and L somewhere a program can read
  them. It is deliberately not a good URDF: no inertia, no collision, no
  materials worth the name. Week 8 writes the real one.

  The two numbers from the lecture:

      r = 0.033 m   the wheel radius      -> <cylinder radius="0.033">
      L = 0.160 m   the wheel separation  -> the DISTANCE between the two
                                             joint origins, y = +0.080 and
                                             y = -0.080. It is never written
                                             down as a single number.
-->
<robot name="burger_min">

  <!-- The body. Everything else is positioned relative to this. -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.140 0.140 0.080"/>
      </geometry>
      <material name="grey">
        <color rgba="0.4 0.4 0.45 1.0"/>
      </material>
    </visual>
  </link>

  <!-- LEFT WHEEL ........................................................ -->
  <link name="wheel_left_link">
    <visual>
      <!-- A cylinder's axis in URDF runs along z, so it is rolled a quarter
           turn about x to stand it up as a wheel. -->
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <material name="dark">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <!-- Half of L, to the left. -->
    <origin xyz="0 0.080 0"/>
    <!-- The wheel spins about the body's y axis: the axle. -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RIGHT WHEEL ....................................................... -->
  <link name="wheel_right_link">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <material name="dark">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <!-- Half of L, to the right. The gap between this and the line above
         is L = 0.160 m, and that is the only place L exists. -->
    <origin xyz="0 -0.080 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- A caster, so the box does not float. Not part of the kinematics:
       the model has two driven wheels, and this one just holds the back up. -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.055 0 -0.018"/>
  </joint>

</robot>
